[Unit]
Description=Avcel Jev threat-triage experiment
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=avcel-jev
Group=avcel-jev
WorkingDirectory=/opt/avcel-jev/current
EnvironmentFile=/etc/avcel-jev/avcel-jev.env
Environment=HOST=127.0.0.1
Environment=PORT=8791
Environment=AVCEL_DATA_DIR=/var/lib/avcel-jev
Environment=AVCEL_MAX_RECORDS=250
ExecStart=/opt/avcel-jev/runtime/current/bin/node /opt/avcel-jev/current/dist/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0027
MemoryHigh=160M
MemoryMax=256M
CPUQuota=40%
TasksMax=48
LimitNPROC=48
LimitNOFILE=2048
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/avcel-jev
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
